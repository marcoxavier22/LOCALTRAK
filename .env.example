# =============================================================================
# BACKEND API (apps/api)
# =============================================================================

# URL de conexao PostgreSQL. Em Supabase use sslmode=require.
# Exemplo: postgresql://postgres:SENHA@db.REF.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=""

# Secrets fortes e DIFERENTES para assinar access e refresh tokens JWT.
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""

# Tempo de expiracao dos tokens.
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Porta da API. Render/Railway sobrescrevem via variavel PORT automaticamente.
PORT=3333

# Origens permitidas para CORS, separadas por virgula.
# Exemplo: https://SEU-APP.vercel.app,http://localhost:3000,http://localhost:8081
CORS_ORIGINS=""

# Usuario MASTER_ADMIN criado pelo seed se ainda nao existir.
# NAO expor em frontend ou codigo publico.
MASTER_ADMIN_NAME="Admin Master"
MASTER_ADMIN_EMAIL="admin@routify.test"
MASTER_ADMIN_PASSWORD=""

# Supabase — APENAS backend. Nunca expor SUPABASE_SERVICE_ROLE_KEY no frontend.
# A service role key tem acesso total ao banco sem restricao de RLS.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
# Alternativa para novos projetos com chave no formato sb_secret_*
SUPABASE_SECRET_KEY=""
SUPABASE_STORAGE_BUCKET="order-odometer"

# =============================================================================
# FRONTEND WEB (apps/web — Vercel)
# Variaveis com NEXT_PUBLIC_ sao expostas no browser. Nunca coloque secrets aqui.
# =============================================================================
NEXT_PUBLIC_API_URL="http://localhost:3333"
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Aliases para compatibilidade com diferentes convencoes da Vercel:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
NEXT_PUBLIC_SUPABASE_KEY=""

# =============================================================================
# APP MOBILE (apps/mobile — Expo)
# Variaveis com EXPO_PUBLIC_ sao expostas no bundle. Nunca coloque secrets aqui.
# =============================================================================
EXPO_PUBLIC_API_URL="http://localhost:3333"
EXPO_PUBLIC_SUPABASE_URL=""
EXPO_PUBLIC_SUPABASE_ANON_KEY=""
