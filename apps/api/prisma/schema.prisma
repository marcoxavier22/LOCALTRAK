generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MASTER_ADMIN
  COMPANY_ADMIN
  EMPLOYEE
}

enum CompanyStatus {
  ACTIVE
  TRIAL
  DELINQUENT
  BLOCKED
  ARCHIVED
}

enum VehicleType {
  CAR
  MOTORCYCLE
  PICKUP
  VAN
  TRUCK
  OTHER
}

enum VehicleOwnershipType {
  COMPANY
  EMPLOYEE
}

enum VehicleStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

enum FuelType {
  GASOLINE
  ETHANOL
  DIESEL
  FLEX
  ELECTRIC
  HYBRID
  OTHER
}

enum RouteShiftStatus {
  PENDING
  IN_PROGRESS
  FINISHED
  SYNC_PENDING
  ERROR
}

enum MaintenanceType {
  OIL_CHANGE
  PREVENTIVE_REVIEW
  TIRES
  BRAKES
  CUSTOM
}

enum MaintenanceStatus {
  DONE
  SCHEDULED
  OVERDUE
  CANCELED
}

enum ReimbursementPaymentStatus {
  PENDING
  PAID
  CANCELED
}

enum ServiceOrderStatus {
  PENDING
  IN_PROGRESS
  FINISHED
  CANCELED
}

enum ServiceOrderStopStatus {
  PENDING
  COMPLETED
}

model User {
  id                    String       @id @default(uuid())
  name                  String
  email                 String       @unique
  phone                 String?
  passwordHash          String       @map("password_hash")
  refreshTokenHash      String?      @map("refresh_token_hash")
  role                  Role
  companyId             String?      @map("company_id")
  company               Company?     @relation(fields: [companyId], references: [id])
  isActive              Boolean      @default(true) @map("is_active")
  termsAcceptedAt       DateTime?    @map("terms_accepted_at")
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")
  vehicles              Vehicle[]
  routeShifts           RouteShift[]
  serviceOrders         ServiceOrder[]
  reimbursementPayments ReimbursementPayment[] @relation("EmployeeReimbursementPayments")
  consentLogs           ConsentLog[]
  auditLogs             AuditLog[]

  @@index([companyId])
  @@index([companyId, role])
  @@map("users")
}

model Company {
  id           String          @id @default(uuid())
  name         String
  document     String?         @unique
  phone        String?
  email        String?
  status       CompanyStatus   @default(TRIAL)
  planId       String?         @map("plan_id")
  plan         Plan?           @relation(fields: [planId], references: [id])
  maxEmployees Int             @default(5) @map("max_employees")
  maxVehicles  Int             @default(5) @map("max_vehicles")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  users        User[]
  vehicles     Vehicle[]
  routeShifts  RouteShift[]
  serviceOrders ServiceOrder[]
  serviceOrderStops ServiceOrderStop[]
  maintenanceRules MaintenanceRule[]
  vehicleMaintenances VehicleMaintenance[]
  fuelSettings FuelSetting[]
  reimbursementPayments ReimbursementPayment[]
  consentLogs  ConsentLog[]
  auditLogs    AuditLog[]

  @@map("companies")
}

model Plan {
  id                String    @id @default(uuid())
  name              String
  price             Decimal   @default(0) @db.Decimal(12, 2)
  maxEmployees      Int       @map("max_employees")
  maxVehicles       Int       @map("max_vehicles")
  maxRoutesPerMonth Int       @map("max_routes_per_month")
  features          Json      @default("{}")
  isActive          Boolean   @default(true) @map("is_active")
  companies         Company[]

  @@map("plans")
}

model Vehicle {
  id                 String               @id @default(uuid())
  companyId          String               @map("company_id")
  company            Company              @relation(fields: [companyId], references: [id])
  employeeId         String?              @map("employee_id")
  employee           User?                @relation(fields: [employeeId], references: [id])
  plate              String
  brand              String
  model              String
  year               Int?
  type               VehicleType
  ownershipType      VehicleOwnershipType @map("ownership_type")
  currentKm          Decimal              @default(0) @map("current_km") @db.Decimal(12, 2)
  fuelType           FuelType?            @map("fuel_type")
  averageConsumption Decimal?             @map("average_consumption") @db.Decimal(8, 2)
  costPerKm          Decimal?             @map("cost_per_km") @db.Decimal(8, 2)
  status             VehicleStatus        @default(ACTIVE)
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  routeShifts        RouteShift[]
  serviceOrders      ServiceOrder[]
  maintenances       VehicleMaintenance[]
  reimbursementPayments ReimbursementPayment[]

  @@unique([companyId, plate])
  @@index([companyId])
  @@index([employeeId])
  @@map("vehicles")
}

model RouteShift {
  id                   String           @id @default(uuid())
  companyId            String           @map("company_id")
  company              Company          @relation(fields: [companyId], references: [id])
  employeeId           String           @map("employee_id")
  employee             User             @relation(fields: [employeeId], references: [id])
  vehicleId            String?          @map("vehicle_id")
  vehicle              Vehicle?         @relation(fields: [vehicleId], references: [id])
  startedAt            DateTime         @map("started_at")
  endedAt              DateTime?        @map("ended_at")
  startLatitude        Decimal?         @map("start_latitude") @db.Decimal(10, 7)
  startLongitude       Decimal?         @map("start_longitude") @db.Decimal(10, 7)
  endLatitude          Decimal?         @map("end_latitude") @db.Decimal(10, 7)
  endLongitude         Decimal?         @map("end_longitude") @db.Decimal(10, 7)
  totalDistanceKm      Decimal          @default(0) @map("total_distance_km") @db.Decimal(12, 3)
  totalDurationMinutes Int              @default(0) @map("total_duration_minutes")
  stoppedTimeMinutes   Int              @default(0) @map("stopped_time_minutes")
  estimatedFuelCost    Decimal          @default(0) @map("estimated_fuel_cost") @db.Decimal(12, 2)
  reimbursementValue   Decimal          @default(0) @map("reimbursement_value") @db.Decimal(12, 2)
  status               RouteShiftStatus @default(PENDING)
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")
  points               RoutePoint[]
  serviceOrder         ServiceOrder?

  @@index([companyId, startedAt])
  @@index([companyId, status])
  @@index([employeeId, startedAt])
  @@index([vehicleId])
  @@map("route_shifts")
}

model RoutePoint {
  id            String     @id @default(uuid())
  routeShiftId  String     @map("route_shift_id")
  routeShift    RouteShift @relation(fields: [routeShiftId], references: [id], onDelete: Cascade)
  latitude      Decimal    @db.Decimal(10, 7)
  longitude     Decimal    @db.Decimal(10, 7)
  accuracy      Decimal?   @db.Decimal(8, 2)
  speed         Decimal?   @db.Decimal(8, 2)
  altitude      Decimal?   @db.Decimal(8, 2)
  batteryLevel  Decimal?   @map("battery_level") @db.Decimal(5, 2)
  recordedAt    DateTime   @map("recorded_at")
  createdAt     DateTime   @default(now()) @map("created_at")

  @@index([routeShiftId, recordedAt])
  @@map("route_points")
}

model MaintenanceRule {
  id           String          @id @default(uuid())
  companyId    String          @map("company_id")
  company      Company         @relation(fields: [companyId], references: [id])
  name         String
  type         MaintenanceType
  intervalKm   Int?            @map("interval_km")
  intervalDays Int?            @map("interval_days")
  isActive     Boolean         @default(true) @map("is_active")
  maintenances VehicleMaintenance[]

  @@index([companyId])
  @@map("maintenance_rules")
}

model VehicleMaintenance {
  id                String             @id @default(uuid())
  companyId         String             @map("company_id")
  company           Company            @relation(fields: [companyId], references: [id])
  vehicleId         String             @map("vehicle_id")
  vehicle           Vehicle            @relation(fields: [vehicleId], references: [id])
  maintenanceRuleId String?            @map("maintenance_rule_id")
  maintenanceRule   MaintenanceRule?   @relation(fields: [maintenanceRuleId], references: [id])
  type              MaintenanceType    @default(CUSTOM)
  description       String?
  performedAt       DateTime?          @map("performed_at")
  performedKm       Int?               @map("performed_km")
  nextDueKm         Int?               @map("next_due_km")
  nextDueDate       DateTime?          @map("next_due_date")
  cost              Decimal?           @db.Decimal(12, 2)
  status            MaintenanceStatus  @default(SCHEDULED)

  @@index([companyId])
  @@index([vehicleId])
  @@map("vehicle_maintenances")
}

model FuelSetting {
  id               String   @id @default(uuid())
  companyId        String   @map("company_id")
  company          Company  @relation(fields: [companyId], references: [id])
  fuelType         FuelType @map("fuel_type")
  pricePerLiter    Decimal? @map("price_per_liter") @db.Decimal(8, 3)
  defaultCostPerKm Decimal? @map("default_cost_per_km") @db.Decimal(8, 3)

  @@unique([companyId, fuelType])
  @@map("fuel_settings")
}

model ReimbursementPayment {
  id          String                     @id @default(uuid())
  companyId   String                     @map("company_id")
  company     Company                    @relation(fields: [companyId], references: [id])
  employeeId  String                     @map("employee_id")
  employee    User                       @relation("EmployeeReimbursementPayments", fields: [employeeId], references: [id])
  vehicleId   String?                    @map("vehicle_id")
  vehicle     Vehicle?                   @relation(fields: [vehicleId], references: [id])
  distanceKm  Decimal                    @default(0) @map("distance_km") @db.Decimal(12, 3)
  fuelCost    Decimal                    @default(0) @map("fuel_cost") @db.Decimal(12, 2)
  amount      Decimal                    @db.Decimal(12, 2)
  description String?
  paidAt      DateTime                   @map("paid_at")
  status      ReimbursementPaymentStatus @default(PAID)
  createdAt   DateTime                   @default(now()) @map("created_at")
  updatedAt   DateTime                   @updatedAt @map("updated_at")

  @@index([companyId, paidAt])
  @@index([employeeId, paidAt])
  @@index([vehicleId, paidAt])
  @@map("reimbursement_payments")
}

model ServiceOrder {
  id                       String             @id @default(uuid())
  companyId                String             @map("company_id")
  company                  Company            @relation(fields: [companyId], references: [id])
  title                    String
  description              String?
  employeeId               String?            @map("employee_id")
  employee                 User?              @relation(fields: [employeeId], references: [id])
  vehicleId                String?            @map("vehicle_id")
  vehicle                  Vehicle?           @relation(fields: [vehicleId], references: [id])
  routeShiftId             String?            @unique @map("route_shift_id")
  routeShift               RouteShift?        @relation(fields: [routeShiftId], references: [id], onDelete: SetNull)
  status                   ServiceOrderStatus @default(PENDING)
  scheduledDate            DateTime           @map("scheduled_date")
  startedAt                DateTime?          @map("started_at")
  finishedAt               DateTime?          @map("finished_at")
  initialOdometerKm        Decimal?           @map("initial_odometer_km") @db.Decimal(12, 2)
  finalOdometerKm          Decimal?           @map("final_odometer_km") @db.Decimal(12, 2)
  initialOdometerPhotoPath String?            @map("initial_odometer_photo_path")
  finalOdometerPhotoPath   String?            @map("final_odometer_photo_path")
  notes                    String?
  createdAt                DateTime           @default(now()) @map("created_at")
  updatedAt                DateTime           @updatedAt @map("updated_at")
  stops                    ServiceOrderStop[]

  @@index([companyId, scheduledDate])
  @@index([companyId, status])
  @@index([employeeId, scheduledDate])
  @@index([vehicleId, scheduledDate])
  @@index([routeShiftId])
  @@map("service_orders")
}

model ServiceOrderStop {
  id          String                 @id @default(uuid())
  companyId   String                 @map("company_id")
  company     Company                @relation(fields: [companyId], references: [id])
  orderId     String                 @map("order_id")
  order       ServiceOrder           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerName String?               @map("customer_name")
  address     String
  latitude    Decimal?               @db.Decimal(10, 7)
  longitude   Decimal?               @db.Decimal(10, 7)
  visitOrder  Int                    @map("visit_order")
  status      ServiceOrderStopStatus @default(PENDING)
  completedAt DateTime?              @map("completed_at")
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")

  @@index([companyId])
  @@index([orderId, visitOrder])
  @@map("service_order_stops")
}

model ConsentLog {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id])
  companyId    String?  @map("company_id")
  company      Company? @relation(fields: [companyId], references: [id])
  acceptedAt   DateTime @default(now()) @map("accepted_at")
  termsVersion String   @map("terms_version")
  ipAddress    String?  @map("ip_address")

  @@index([userId])
  @@index([companyId])
  @@map("consent_logs")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id])
  companyId String?  @map("company_id")
  company   Company? @relation(fields: [companyId], references: [id])
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([companyId, createdAt])
  @@index([userId])
  @@map("audit_logs")
}
