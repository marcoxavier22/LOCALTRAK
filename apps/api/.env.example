# URL de conexao PostgreSQL. Em Supabase use sslmode=require.
# Direct connection do projeto LocalTrak:
DATABASE_URL="postgresql://postgres:REPLACE_WITH_SUPABASE_DB_PASSWORD@db.bbcubwmvizcmjtwiiyxv.supabase.co:5432/postgres?sslmode=require"

# Secret forte para assinar access tokens JWT.
JWT_ACCESS_SECRET="<chave_forte_access>"

# Secret forte e diferente para assinar refresh tokens JWT.
JWT_REFRESH_SECRET="<chave_forte_refresh>"

# Tempo de expiracao do access token.
JWT_ACCESS_EXPIRES_IN="15m"

# Tempo de expiracao do refresh token.
JWT_REFRESH_EXPIRES_IN="7d"

# Porta da API.
PORT=3333

# Origens permitidas para CORS, separadas por virgula.
CORS_ORIGINS="http://localhost:3000,http://localhost:8081,https://REPLACE_WITH_FRONTEND_URL"

# Mantido para compatibilidade com ambientes antigos.
CORS_ORIGIN="http://localhost:3000"

# Usuario MASTER_ADMIN criado pelo seed se ainda nao existir.
MASTER_ADMIN_NAME="Admin Master"
MASTER_ADMIN_EMAIL="admin@localtrak.test"
MASTER_ADMIN_PASSWORD="ChangeMe123!"

# Supabase Storage para fotos privadas de odometro do modulo de OS.
# Use apenas no backend. Nao publicar em apps/web nem apps/mobile.
SUPABASE_URL="https://REPLACE_WITH_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="REPLACE_WITH_SERVER_ONLY_SERVICE_ROLE_KEY"
# Alternativa para projetos usando as novas chaves do Supabase: sb_secret_...
SUPABASE_SECRET_KEY=""
SUPABASE_STORAGE_BUCKET="order-odometer"
